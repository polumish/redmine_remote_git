<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'remote_git', plugin: 'redmine_remote_git' %>
<% end %>

<h2><span class="icon-remote-git"></span> <%= l(:label_remote_git_overview) %></h2>

<p class="subtitle">
  <%= l(:label_remote_git_overview_summary,
        count: @repositories.size,
        active: @repositories.count { |r| r.project.active? }) %>
</p>

<% if @repositories.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <table class="list remote-git-repos">
    <thead>
      <tr>
        <th><%= l(:label_repository) %></th>
        <th><%= l(:label_project) %></th>
        <th><%= l(:field_status) %></th>
        <th class="center"><%= l(:label_revision_plural) %></th>
        <th><%= l(:label_remote_git_last_change) %></th>
      </tr>
    </thead>
    <tbody>
      <% @repositories.each do |repo| %>
        <% proj = repo.project %>
        <% last = @last_dates[repo.id] %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td>
            <%= link_to repo.identifier,
                  url_for(controller: 'repositories', action: 'show', id: proj,
                          repository_id: repo.identifier, only_path: true) %>
          </td>
          <td><%= link_to_project proj %></td>
          <td>
            <% if proj.active? %><span class="active"><%= l(:label_remote_git_status_active) %></span>
            <% elsif proj.archived? %><span class="archived"><%= l(:label_remote_git_status_archived) %></span>
            <% else %><%= l(:label_remote_git_status_closed) %><% end %>
          </td>
          <td class="center"><%= @counts[repo.id] || 0 %></td>
          <td>
            <% if last %><%= format_time(last) %><% else %>&mdash;<% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h3><%= l(:label_remote_git_recent_changes) %></h3>
  <table class="list changesets">
    <thead>
      <tr>
        <th><%= l(:label_date) %></th>
        <th><%= l(:label_repository) %></th>
        <th><%= l(:field_author) %></th>
        <th><%= l(:field_comments) %></th>
      </tr>
    </thead>
    <tbody>
      <% @recent_changesets.each do |cs| %>
        <% repo = cs.repository; proj = repo.project %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td><%= format_time(cs.committed_on) %></td>
          <td>
            <%= link_to repo.identifier,
                  url_for(controller: 'repositories', action: 'revision', id: proj,
                          repository_id: repo.identifier, rev: cs.revision, only_path: true) %>
          </td>
          <td><%= cs.committer.to_s.sub(/<.*>/, '').strip %></td>
          <td><%= textilizable(cs.comments.to_s.truncate(120), project: proj) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
