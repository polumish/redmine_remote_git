<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'remote_git', plugin: 'redmine_remote_git' %>
  <%= javascript_include_tag 'remote_git', plugin: 'redmine_remote_git' %>
<% end %>

<div class="remote-git-overview">
<h2><span class="icon-remote-git"></span> <%= l(:label_remote_git_overview) %></h2>

<p class="subtitle">
  <%= l(:label_remote_git_overview_summary, count: @repositories.size, active: @active_repositories.size) %>
</p>

<% if @repositories.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <p>
    <input type="text" id="remote-git-filter" class="remote-git-filter"
           placeholder="<%= l(:label_remote_git_filter) %>" autocomplete="off" />
  </p>

  <%= render partial: 'repo_table',
             locals: { repos: @active_repositories, table_class: 'remote-git-repos' } %>

  <% if @archived_repositories.any? %>
    <p>
      <a href="#" id="remote-git-archived-toggle" class="icon icon-collapsed">
        <%= l(:label_remote_git_archived, count: @archived_repositories.size) %>
      </a>
    </p>
    <div id="remote-git-archived" style="display:none;">
      <%= render partial: 'repo_table',
                 locals: { repos: @archived_repositories, table_class: 'remote-git-archived' } %>
    </div>
  <% end %>

  <h3><%= l(:label_remote_git_recent_changes) %></h3>
  <table class="list remote-git-changes">
    <thead>
      <tr>
        <th><%= l(:label_date) %></th>
        <th><%= l(:label_repository) %></th>
        <th><%= l(:field_author) %></th>
        <th><%= l(:field_comments) %></th>
      </tr>
    </thead>
    <tbody>
      <% @recent_changesets.each do |cs| %>
        <% repo = cs.repository; proj = repo.project %>
        <tr>
          <td><%= format_time(cs.committed_on) %></td>
          <td>
            <%= link_to repo.identifier,
                  url_for(controller: 'repositories', action: 'revision', id: proj,
                          repository_id: repo.identifier, rev: cs.revision, only_path: true) %>
          </td>
          <td><%= cs.committer.to_s.sub(/<.*>/, '').strip %></td>
          <td><%= textilizable(cs.comments.to_s.truncate(120), project: proj) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
</div>
